# ==============================================================================
# CLOUDPULSE — Environment Configuration Example (.env.example)
#
# Copy this file to .env or .env.local and configure appropriately.
# NEVER commit real credentials, tokens, private keys, or passwords to git.
# ==============================================================================

# ─── Server & Network ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
API_VERSION=v1
API_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5173

# ─── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=your-256-bit-jwt-secret-here
SESSION_SECRET=your-session-secret-here
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ─── Identity Providers / OAuth 2.0 & OIDC ──────────────────────────────────
# Google Workspace / Gmail OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 / Entra ID (Azure AD)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Apple ID Sign-In
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ─── OpenTelemetry & Ingestion Engine ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TELEMETRY_ENGINE_PORT=4318

# ─── Multi-Cloud Infrastructure (Optional Defaults) ───────────────────────────
# AWS Cross-Account AssumeRole Defaults
AWS_DEFAULT_REGION=us-east-1

# Microsoft Azure Defaults
AZURE_TENANT_ID=

# Google Cloud Platform Defaults
GCP_PROJECT_ID=

# Kubernetes Cluster Configuration (Optional local override)
KUBECONFIG=

# ─── Microservices Gateway & Demo Services (Local Development) ───────────────
API_GATEWAY_PORT=4000
ORDER_SERVICE_PORT=4001
PAYMENT_SERVICE_PORT=4002
TRAFFIC_INTERVAL_MS=2000
